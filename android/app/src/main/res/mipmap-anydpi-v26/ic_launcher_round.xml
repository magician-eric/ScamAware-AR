<?xml version="1.0" encoding="utf-8"?>
<!--
  android:roundIcon, for the launchers that ask for one. It is deliberately the same two layers
  as ic_launcher.xml rather than a separately drawn round variant: an adaptive icon is already
  shape-agnostic - the launcher supplies the mask, round included - so a second artwork would
  only be a second thing to keep in step with the PWA.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
