<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <!-- CIBAR 現在顯示在本 APP 內的 WebView（見 CibarWebViewController），所以真的需要連網。
         這一行必須留在 JJSDK 的 tools:node="remove" 清單之外：那份清單原本把 INTERNET
         一併移除，WebView 就只會顯示 net::ERR_ACCESS_DENIED 空白頁。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 影像來自眼鏡的 USB 相機（JJSDK CameraManager），手機內建相機並非必要硬體。
         宣告 required="false" 可避免 Google Play 誤判並修正 lint 的
         PermissionImpliesUnsupportedChromeOsHardware 錯誤。 -->
    <uses-feature android:name="android.hardware.camera" android:required="false"
        tools:replace="android:required" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"
        tools:replace="android:required" />
    <!-- 眼鏡必須靠 USB host 才能運作，但宣告成必要硬體會讓部分裝置的安裝程式直接拒裝；
         偵測不到裝置時 APP 本來就會在診斷面板明確說明，所以這裡宣告為非必要。 -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- JJSDK 的 AAR manifest 會把下列項目併進來，全部都不是本 APP 需要的能力。
         其中 android.hardware.opengles.aep（OpenGL ES Extension Pack）被原廠標成
         required="true"，而支援 AEP 的 GPU 相當少；只要測試手機不支援，安裝程式就會
         直接拒絕安裝，而且不會說明原因。本 APP 只用 SurfaceView 顯示眼鏡影像，不錄音、
         不讀寫外部儲存空間，因此在合併階段就把它們全部移除，只保留真正用到的 CAMERA 與
         INTERNET 權限。移除宣告不會拿掉裝置本身的能力，SDK 的繪圖路徑不受影響。 -->
    <uses-feature android:name="android.hardware.opengles.aep" tools:node="remove" />
    <uses-feature android:name="com.android.hardware.camera2.full" tools:node="remove" />
    <uses-feature android:glEsVersion="0x00030000" tools:node="remove" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" tools:node="remove" />

    <!-- 桌面圖示名稱由 @string/app_name 決定，而它在兩個 flavor 各自被覆寫成
         「反詐AR體驗線上版」與「反詐AR體驗線下版」（見 src/online/res/values/strings.xml
         與 src/offline/res/values/strings.xml）。兩支 APK 可以同時裝在同一支手機上，名稱
         一樣的話桌面上就會出現兩個分不出來的圖示。

         產品名本身仍沿用 CIBAR PWA 的正式中文名稱（見 repo 根目錄的 manifest.json 與
         webapp/public/manifest.json），不另取工程用代號：測試者手機上的 App 名稱要跟他在
         瀏覽器裡看到的同一個產品對得起來。AppIdentityTest 會把兩個 flavor 的字串跟 PWA
         manifest 綁在一起，任何一邊改名而其他邊沒跟上就會讓建置失敗。 -->
    <!-- 桌面圖示同樣沿用 CIBAR PWA 的正式 icon（webapp/public/icons/），不另外畫一套 Android
         專用的視覺：ic_launcher 的 adaptive 版本直接引用 icon-512-maskable.png 的位元組副本，
         AppIconTest 會把兩邊綁在一起，其中一邊換圖而另一邊沒跟上就會讓建置失敗。
         roundIcon 指向同一組圖層 —— adaptive icon 的形狀本來就由 launcher 的 mask 決定。 -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- launchMode singleTask: there is only ever one CIBAR. Anything that launches the app
             again while it is running - an older install's plug-in filter, the vendor app, a
             launcher tap - is delivered to the running activity (onNewIntent) instead of
             stacking a second one on top. Two of them fought over the glasses' USB devices and
             the WebView, and the new one stopped on the opening artwork until the app was closed
             and opened again.

             configChanges: the glasses enumerate as a USB keyboard too (the ToF module presses
             arrow keys for its gestures), so a hardware keyboard appearing or going away is a
             normal event here, not a reason to tear the activity down. Without keyboard and
             navigation listed, Android destroys and recreates the activity when that happens:
             the hardware is released, CIBAR starts over from its opening, and to the person
             holding the phone the app has crashed. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|smallestScreenSize|screenLayout|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- No USB_DEVICE_ATTACHED filter (removed in 1.2.6). Plugging the glasses in used
                 to launch this app, but a launch from that intent came up on a blank, frozen
                 home screen. The app is now opened by hand; glasses plugged in while it is open
                 are still picked up by JorjinHardwareManager's runtime receiver, and USB access
                 is asked for through the normal permission dialog. -->
        </activity>

        <!-- 工作人員管理模式的「匯出紀錄檔」：把 tof-frames.txt 交給分享選單裡選的 APP（LINE、
             Email、雲端硬碟）。不對外開放，別的 APP 只能透過分享時附帶的單一檔案讀取授權拿到
             那一個匯出檔；只讀，只認 TofLogExport 產生的檔名。見 TofLogProvider。 -->
        <provider
            android:name=".TofLogProvider"
            android:authorities="${applicationId}.toflog"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>

</manifest>
